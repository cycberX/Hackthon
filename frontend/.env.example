# =============================================================================
# OneAPI Frontend Environment Template (.env.example)
# Copy this file to .env.local or set these variables in Vercel project settings
# =============================================================================

# Backend Gateway API Base URL (Point to your deployed backend on Vercel/Railway/Render)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_BASE_URL=http://localhost:5000

# Frontend Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Settings
NEXT_PUBLIC_DEFAULT_PROVIDER=auto
NEXT_PUBLIC_APP_NAME="OneAPI Platform"
