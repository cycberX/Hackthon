# =============================================================================
# OneAPI Frontend Production Environment Template (.env.production)
# Configure these in your Vercel Dashboard -> Settings -> Environment Variables
# =============================================================================

# Production Backend Gateway API Base URL
NEXT_PUBLIC_API_URL=https://hack-vsak-backend.vercel.app
NEXT_PUBLIC_BACKEND_URL=https://hack-vsak-backend.vercel.app
NEXT_PUBLIC_BASE_URL=https://hack-vsak-backend.vercel.app

# Production Frontend Application Base URL
NEXT_PUBLIC_APP_URL=https://hack-vsak-frontend.vercel.app
NEXT_PUBLIC_SITE_URL=https://hack-vsak-frontend.vercel.app

NEXT_PUBLIC_DEFAULT_PROVIDER=auto
NEXT_PUBLIC_APP_NAME="OneAPI Platform"
