# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/hack_vsak

# Generated Cryptographically Secure JWT Secret Tokens
JWT_SECRET=your_secure_generated_jwt_secret_token_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_secure_generated_jwt_refresh_secret_token_here
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=*

# OneAPI Vault Master Encryption Key (32 bytes / 64 hex characters)
VAULT_MASTER_KEY=your_32_byte_hex_encryption_key_here

# Email Service
EMAIL_FROM="OneAPI Security <no-reply@oneapi.dev>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
