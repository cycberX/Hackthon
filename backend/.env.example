# =============================================================================
# OneAPI Backend Gateway Environment Template (.env.example)
# =============================================================================

# Server & Gateway Base URLs
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000
API_BASE_URL=http://localhost:5000/api/v1
FRONTEND_URL=http://localhost:3000

# MongoDB Connection String (Atlas URI or local replica)
MONGODB_URI=mongodb://127.0.0.1:27017/hack_vsak

# Generated Cryptographically Secure JWT Secret Tokens
JWT_SECRET=your_secure_generated_jwt_secret_token_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_secure_generated_jwt_refresh_secret_token_here
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration (Set to specific production origin on deploy e.g. https://your-frontend.vercel.app)
CORS_ORIGIN=*

# OneAPI Vault Master Encryption Key (32 bytes / 64 hex characters)
VAULT_MASTER_KEY=your_32_byte_hex_encryption_key_here

# Email Service
EMAIL_FROM="OneAPI Security <no-reply@oneapi.dev>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_SECURE=false
